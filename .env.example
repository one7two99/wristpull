# Copy to .env (git-ignored) and fill in. Used by compose.yaml.

# Host user that owns ~/Health/wristpull (id -u / id -g)
UID=1000
GID=1000

# Data directory and config file on the host
WRISTPULL_DATA=/home/alice/Health/wristpull
WRISTPULL_CONFIG=/home/alice/.config/wristpull/config.toml

# Addresses Caddy serves (comma-separated): the laptop's LAN address for the phone, localhost for the laptop
WRISTPULL_SITE=https://192.168.1.10:8443, https://localhost:8443

# Session signing secret: keeps you logged in across restarts. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WRISTPULL_WEB_SECRET=

# Password hash (never the password itself). Generate with:
#   uv run wristpull serve --hash-password
WRISTPULL_WEB_PASSWORD_HASH=

# Optional: where the container finds Ollama (default http://host.docker.internal:11434).
# Never set OLLAMA_HOST=0.0.0.0 on the host; see README "Web dashboard".
# WRISTPULL_OLLAMA_URL=http://host.docker.internal:11434

# Optional: API keys for coach runs started from the browser
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# --- `cli` and `agent` services (device access: docker compose run --rm cli wristpull ..., and the agent
# that runs the dashboard's device jobs) --------------------------------------------------------
# Auth key of the Zepp OS band for `pull strap` (32 hex digits, from Gadgetbridge's device settings or huami-token);
# `wristpull strap pair --authkey ... --address ...` checks it against the band and writes the address to the config.
# WRISTPULL_STRAP_AUTHKEY=0x00112233445566778899aabbccddeeff
# Group that may open the USB device nodes inside the container: `getent group plugdev | cut -d: -f3`
WRISTPULL_USB_GID=46
# adb keys live in ${WRISTPULL_DATA}/adb (seed once: mkdir -p ~/Health/wristpull/adb && cp ~/.android/adbkey* ~/Health/wristpull/adb/)
# Editor for `workout new --edit` and the TUI (nano is in the image); TERM/COLORTERM/LANG come from your shell.
# EDITOR=nano
