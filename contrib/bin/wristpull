#!/bin/sh
# wristpull from the Docker image: runs `docker compose run --rm cli wristpull "$@"` so the commands
# feel native. Finds the compose.yaml two directories above itself (run from the checkout), else
# ~/dev/wristpull, unless WRISTPULL_COMPOSE says otherwise. Optional: copy it to ~/.local/bin/.
set -eu
here="$(cd "$(dirname "$0")" && pwd -P)"
compose="${WRISTPULL_COMPOSE:-$here/../../compose.yaml}"
[ -f "$compose" ] || compose="$HOME/dev/wristpull/compose.yaml"
if [ ! -f "$compose" ]; then
    echo "wristpull: compose file not found: $compose (set WRISTPULL_COMPOSE)" >&2
    exit 2
fi
tty_flag=""
[ -t 0 ] && [ -t 1 ] || tty_flag="-T"   # no pseudo-terminal when piped or run from a timer
exec docker compose -f "$compose" run --rm $tty_flag cli wristpull "$@"
