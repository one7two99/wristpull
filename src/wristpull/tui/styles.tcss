Screen {
    layout: vertical;
}

.row {
    height: auto;
}

.row.grow {
    height: 1fr;
}

#home {
    height: 1fr;
}

#kpis {
    height: 6;
    border: round $primary;
    padding: 0 1;
}

#kpi-title {
    height: 1;
    border: none;
    padding: 0 1;
    color: $text-muted;
}

#recent {
    width: 1fr;
    border: round $primary;
}

#notes {
    width: 44;
}

#devices, #store {
    width: 1fr;
}

#sync {
    height: 1fr;
}

#forms {
    width: 42;
    border: round $primary;
    padding: 0 1;
}

.form {
    height: auto;
    margin-bottom: 1;
}

.form-title {
    text-style: bold;
    color: $accent;
}

#forms Button {
    width: 100%;
    margin-top: 1;
}

#log-side {
    width: 1fr;
}

#result {
    height: auto;
    max-height: 12;
}

#days {
    height: 1fr;
}

#period {
    height: 3;
}

#daytable {
    width: 1fr;
    border: round $primary;
}

#detail {
    width: 54;
}

#files {
    height: 1fr;
}

#tree {
    width: 40;
    border: round $primary;
}

#file-side {
    width: 1fr;
}

#file-info {
    height: auto;
}

#file-inspect {
    height: 1fr;
}

#config {
    height: 1fr;
}

#activities, #sleep, #export, #settings {
    height: 1fr;
}

#act-top {
    height: 3;
}

#act-top Panel {
    width: 1fr;
}

#filter {
    width: 36;
}

#acttable, #nights {
    width: 1fr;
    border: round $primary;
}

#actdetail {
    width: 58;
}

#nightdetail {
    width: 62;
}

#exportform, #settingsform {
    width: 46;
    border: round $primary;
    padding: 0 1;
}

#export-side, #settings-side {
    width: 1fr;
}

#export-result, #settings-status {
    height: auto;
    max-height: 14;
}

#export-preview, #settings-preview {
    height: 1fr;
}

Button.small {
    width: auto;
    min-width: 8;
    margin: 0 1 0 0;
}

#exportform Button, #settingsform Button {
    margin-top: 1;
}

RadioSet {
    width: 100%;
}

#coach {
    height: 1fr;
}

#coach-status {
    height: auto;
    max-height: 5;
}

#runs {
    width: 70;
    border: round $primary;
}

#answer-scroll {
    width: 1fr;
}

#coach-answer {
    height: auto;
}

#question {
    dock: bottom;
    margin-bottom: 1;
}

#workouts {
    height: 1fr;
}

#workouts-status {
    height: auto;
    max-height: 6;
}

#workout-table {
    width: 72;
    border: round $primary;
}

#preview-scroll {
    width: 1fr;
}

#workout-preview {
    height: auto;
}
